#!/bin/bash
#SBATCH -A ProjectXXXX 	  			        ##Project's name
#SBATCH -J EXP_MET 					##Job's name
#sbatch --partition=big --constraint=3TB		##Project's partition
#SBATCH --nodes=1					##Requested node for the job
#SBATCH --ntasks=1					##No. of task per node
#SBATCH --cpus-per-task=42  ##Max is 48			##No. of CPU to run tasks
#SBATCH -t 72:00:00					##Time to run job (Max = -t 10-00:00:00)
#SBATCH --error EXP_MET.err				##Error file incase of an error
#SBATCH --output EXP_MET.out				##Output file

##############################################
##Print out some job details for reference
echo "Job started on $(date)"
echo "Running on node: $(hostname)"
echo "Job ID: $SLURM_JOB_ID"

#load modules
ml SAMtools
ml HTSlib 
ml STAR  ## https://github.com/alexdobin/STAR
ml HTSeq ## https://github.com/htseq/htseq
ml parallel
###############################################
##Change to the current directory that contains the aligned_mod001 folder.
##1. Generate ref. index before alignment
##cd .
cd RNASeq  ##directory containing .fq files

## if .fa or .gtf file is zipped unzip
gzip -dc Danio_rerio.GRCz11.dna_sm.primary_assembly.fa.gz > Danio_rerio.GRCz11.dna_sm.primary_assembly.fa
gzip -dc Danio_rerio.GRCz11.110.gtf.gz > Danio_rerio.GRCz11.110.gtf

############ Give full path else the script may give error
FASTA=../RNASeq/Danio_rerio.GRCz11.dna_sm.primary_assembly.fa
GTF=../RNASeq/Danio_rerio.GRCz11.110.gtf
INDEX=../RNASeq/INDEX
THREADS=10

##Run the star index
chmod +x 01A_STAR_index_ref.sh   ##make the script executable first
./01A_STAR_index_ref.sh "$FASTA" "$GTF" "$INDEX" "$THREADS"

echo "STAR genome index created in: $INDEX"
################################################

##2 Read (fastq) alignment using STAR
GENOME=../RNASeq/INDEX
FASTQDIR=../RNASeq/F1_RNASeq_data
OUTDIR=../RNASeq/F1_result
THREADS=5 ##Use 5 threads fro each job

##Run the star  alignment
chmod +x 01B_RNASeq_STAR_alignment.sh   ##make the script executable first
./01B_RNASeq_STAR_alignment.sh "$GENOME" "$FASTQDIR" "$OUTDIR" "$THREADS"

echo "STAR alignment created in: $OUTDIR"
################################################

##3 Count the No. of reads per genes  using HTSeq-count
GTF=../RNASeq/Danio_rerio.GRCz11.110.gtf
BAMDIR=../RNASeq/F1_result
OUTDIR=../RNASeq/F0_HTSeq_count
JOBS=5

##Run the star  alignment
chmod +x 01C_RNASeq_HTSeq_count.sh  ##make the script executable first
./01C_RNASeq_HTSeq_count.sh "$GTF" "$BAMDIR" "$OUTDIR" "$JOBS"

echo "HTSeq count created in: $OUTDIR"
################################################
