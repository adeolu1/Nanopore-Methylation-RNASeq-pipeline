dist_modkit_v0.5.0_5120ef7/modkit dmr pair \
-a F1_PFBSLC1.bed.gz -a F1_PFBSLC2.bed.gz -a F1_PFBSLC3.bed.gz -b F1_Control1.bed.gz -b F1_Control2.bed.gz -b F1_Control3.bed.gz \
